[
  {
    "PropertyGroupId": "Common",
    "PropertyMap": {
      "bootstrap.servers": "${bootstrap.servers}",
      "group.id": "${group.id}",
      "lob": "${lob}",
      "jdbc.driver": "${jdbc.driver}",
      "jdbc.url": "${jdbc.url}",
      "jdbc.user": "${jdbc.user}",
      "jdbc.password": "${jdbc.password}",
      "schema.includePattern": "${schema.includePattern}",
      "schema.excludePattern": "${schema.excludePattern}",
      "entities": "${entities}"
    }
  },
  {
    "PropertyGroupId": "InOut0",
    "PropertyMap": {
      "input.topic": "${input.topic}",
      "output.topic.prefix": "${output.topic.prefix}",
      "failure.topic": "${failure.topic}",
      "output.topic" : "${output.topic}",
      "event.topic" : "${event.topic}"
    }
  },
  {
    "PropertyGroupId": "AuthProperties",
    "PropertyMap": {
      "sasl.mechanism": "AWS_MSK_IAM",
      "sasl.client.callback.handler.class": "software.amazon.msk.auth.iam.IAMClientCallbackHandler",
      "sasl.jaas.config": "software.amazon.msk.auth.iam.IAMLoginModule required;",
      "security.protocol": "SASL_SSL",
      "ssl.truststore.location": "/usr/lib/jvm/java-11-amazon-corretto/lib/security/cacerts",
      "ssl.truststore.password": "changeit"
    }
  }
]